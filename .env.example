# Vertex Docker Configuration
# Copy this file to .env and customize as needed

# Port on which the application will be accessible
# Default: 3000
PORT=3000

# Node environment
# Options: production, development
NODE_ENV=production

# Container name
# Default: vertex
CONTAINER_NAME=vertex

# For Caddy reverse proxy configuration
# Uncomment and set your domain name
# DOMAIN=vertex.example.com
